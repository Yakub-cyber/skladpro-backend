# ── Скопируйте в .env и заполните ────────────────────────────────────────────

# Порт/хост API. 0.0.0.0 — чтобы телефоны в той же Wi-Fi сети могли подключиться.
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Собственный PostgreSQL (локальный или managed на российском хостинге).
# Локально: postgresql://skladpro:пароль@localhost:5432/skladpro
# Managed (пример Timeweb/Selectel/Yandex): строка из панели управления БД.
DATABASE_URL=postgresql://skladpro:CHANGE_ME@localhost:5432/skladpro

# TLS к БД: disable (локально) | require (TLS без проверки CA) | verify (продакшен).
DATABASE_SSL=disable
# Путь к CA-сертификату managed-БД (нужен при DATABASE_SSL=verify).
# DATABASE_SSL_CA=./certs/db-ca.pem

# Секрет подписи access-токенов (МИНИМУМ 32 символа). Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_______________________________________

# Время жизни токенов.
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Разрешённые origins для браузера (веб-версия). Через запятую.
# В development пусто = разрешить всё; в production пусто = запретить всё.
CORS_ORIGINS=http://localhost:5180,https://yakub-cyber.github.io

# Максимум запросов с одного IP в минуту (глобальный rate limit).
RATE_LIMIT_MAX=300

# TRUST_PROXY: включать ТОЛЬКО когда API реально за доверенным прокси, который
# сам ставит X-Forwarded-For. За произвольным прокси или при прямом доступе
# извне подделка XFF позволит атакующему обойти per-IP rate limit
# (перебор PIN/паролей). За nginx с `proxy_set_header X-Forwarded-For
# $proxy_add_x_forwarded_for` — включайте.
TRUST_PROXY=false

# Sentry DSN для мониторинга ошибок бэкенда. Пусто = отключено.
# Получить: https://sentry.io → Projects → Create → Node.js → скопировать DSN.
SENTRY_DSN=

# ── SMTP для password reset (пусто = email отключён, /reset вернёт 200 но
# ничего не отправит; полезно в CI/dev). Любой SMTP-провайдер:
#   Resend:  smtps://resend:re_xxxxxxxx@smtp.resend.com:465
#   Yandex:  smtps://user@yandex.ru:apppass@smtp.yandex.ru:465
#   MailHog: smtp://localhost:1025  (без auth, для локальной разработки)
SMTP_URL=
SMTP_FROM=SkladPro <no-reply@skladpro.ru>
# URL приложения, куда встраивается токен reset в письме: APP_URL/#/reset?token=<token>
APP_URL=https://yakub-cyber.github.io/skladpro/

# ── FCM push (Firebase Cloud Messaging). Пусто — worker не запускается.
# Путь к service-account JSON (Firebase Console → Project Settings → Service accounts).
# Файл кладите в credentials/ (папка в .gitignore).
FIREBASE_CREDENTIALS=./credentials/firebase-admin.json

# ── AI-суппорт (провайдер-агностично — n8n/Zapier/Make/своё) ───────────────
# Куда бэкенд шлёт созданные тикеты. Пусто = тикеты сохраняются в БД,
# но AI-пайплайн не зовётся (dev/CI).
#   Пример: https://n8n.example.ru/webhook/ai-support-intake
AI_SUPPORT_WEBHOOK_URL=
# Секрет HMAC-SHA256 подписи (мин. 16 символов). Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Обязателен, если задан AI_SUPPORT_WEBHOOK_URL.
AI_SUPPORT_HMAC_SECRET=

# ── Бэкапы БД на Яндекс.Диск (WebDAV, 10 ГБ бесплатно) ─────────────────────
# Используется deploy/backup.sh (крон в 03:00). Без этих переменных дамп
# останется только локально в /var/backups/skladpro/.
# app-password: id.yandex.ru → «Пароли и авторизация» → «Пароль приложения».
YADISK_LOGIN=
YADISK_APP_PASSWORD=
YADISK_PATH=skladpro-backups

# ── Prometheus /metrics ────────────────────────────────────────────────────
# Basic-auth для эндпоинта /metrics. Если пусто (или задан только один) —
# эндпоинт открыт (годится только для dev/CI). В prod задать оба.
# METRICS_USER=metrics
# METRICS_PASS=<random 32 chars>

# ── Fiscal (54-ФЗ через АТОЛ Онлайн) ───────────────────────────────────────
# Ключ шифрования пароля ККТ в БД (AES-GCM). ≥ 32 символа. Пусто → эндпоинты
# /v1/fiscal/* возвращают 503, воркер не стартует.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FISCAL_KMS_KEY=
# Базовый URL АТОЛ. По умолчанию — прод. Для интеграционного тестирования:
#   https://testonline.atol.ru/possystem/v5
# FISCAL_ATOL_BASE_URL=

# ── ЮKassa (подписки) ──────────────────────────────────────────────────────
# SHOP_ID + SECRET_KEY из личного кабинета ЮKassa. Если пусто — /v1/subscription/checkout
# вернёт 503, но enforcement лимитов плана работает.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# Куда ЮKassa вернёт пользователя после оплаты. Обычно — фронт с «спасибо».
# YOOKASSA_RETURN_URL=https://yakub-cyber.github.io/skladpro/#/settings/subscription
# Опциональный whitelist IP-адресов ЮKassa для webhook (через запятую).
# Свежие IP в их доках: https://yookassa.ru/developers/using-api/webhooks
# YOOKASSA_WEBHOOK_IP_WHITELIST=

# ── Deprecated alias'ы (для обратной совместимости, будут удалены в v0.2) ──
# Если задано старое имя, а новое пусто — значение прозрачно копируется в новое.
# N8N_SUPPORT_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=

# ── Только для разового переноса данных из Supabase ─────────────────────────
# Строка подключения к СТАРОЙ базе (Supabase Dashboard → Database → Connection
# string, Session pooler порт 5432). Нужна только скрипту migrate:from-supabase.
# SUPABASE_DATABASE_URL=postgresql://postgres.xekqnshkfthvnqfxxjtf:ПАРОЛЬ@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
