{
	"name": "skladpro-backend",
	"version": "0.1.0",
	"description": "SkladPro API — серверная бизнес-логика поверх Supabase Postgres (продажи, проводки, PIN, аудит)",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"migrate": "tsx src/migrate.ts",
		"migrate:from-supabase": "tsx scripts/migrate-from-supabase.ts",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@fastify/cors": "^10.0.1",
		"@fastify/helmet": "^12.0.1",
		"@fastify/rate-limit": "^10.1.1",
		"@sentry/node": "^10.68.0",
		"bcryptjs": "^2.4.3",
		"dotenv": "^16.4.5",
		"fastify": "^5.1.0",
		"firebase-admin": "^14.2.0",
		"jose": "^5.9.6",
		"nodemailer": "^9.0.3",
		"pg": "^8.13.1",
		"prom-client": "^15.1.3",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^22.9.0",
		"@types/nodemailer": "^8.0.1",
		"@types/pg": "^8.11.10",
		"tsx": "^4.19.2",
		"typescript": "^5.6.3",
		"vitest": "^2.1.4"
	}
}
