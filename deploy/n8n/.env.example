# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ Секреты для docker-compose n8n. Скопируйте в .env рядом и заполните.      ║
# ║ .env не коммитьте — он в .gitignore.                                       ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# Публичный домен, на который смотрит n8n. Пример: n8n.example.ru
# В DNS должна быть A-запись DOMAIN → IP этого VPS.
DOMAIN=n8n.example.ru

# Пароль для внутреннего postgres. Сгенерировать:
#   openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Ключ шифрования credentials в n8n (обязательный).
# НИ В КОЕМ СЛУЧАЕ не меняйте после первого запуска: все сохранённые
# API-ключи Anthropic/Telegram/GitHub станут нечитаемыми. Сгенерировать:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_MIN_32_HEX_CHARS_LONG________________
